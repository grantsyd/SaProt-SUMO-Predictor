# -*- coding: utf-8 -*-
"""
Train_SoftVoting_Dataset2.py

Train Dataset2 final classifiers and weighted SoftVoting ensemble model.

Main workflow:
    SaProt center_mean -> AE384 -> NearMiss5178 -> 7:3 split
    ExtraTrees + XGBoost + LightGBM -> weighted SoftVoting

The saved model pack can be used by Predictor.py / predictor_core.py.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
from collections import Counter

import joblib
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, matthews_corrcoef, roc_auc_score, confusion_matrix
from sklearn.ensemble import ExtraTreesClassifier
from xgboost import XGBClassifier
from lightgbm import LGBMClassifier


def count_labels(y):
    c = Counter(np.asarray(y, dtype=np.int64).tolist())
    return {"negative": int(c.get(0, 0)), "positive": int(c.get(1, 0)), "total": int(len(y))}


def calc_metrics(y_true, prob, threshold=0.5):
    pred = (prob >= threshold).astype(int)
    tn, fp, fn, tp = confusion_matrix(y_true, pred, labels=[0, 1]).ravel()
    sn = tp / (tp + fn) if (tp + fn) else 0.0
    sp = tn / (tn + fp) if (tn + fp) else 0.0
    return {
        "Acc": accuracy_score(y_true, pred),
        "Sn": sn,
        "Sp": sp,
        "MCC": matthews_corrcoef(y_true, pred),
        "AUC": roc_auc_score(y_true, prob),
        "TP": int(tp), "TN": int(tn), "FP": int(fp), "FN": int(fn),
    }


def load_labels(dataset_file):
    data = np.load(dataset_file, allow_pickle=True).item()
    return np.asarray(data["labels"], dtype=np.int64)


def load_indices(split_dir, prefix):
    split_dir = Path(split_dir)
    train_idx = np.load(split_dir / f"{prefix}_train_idx.npy").astype(np.int64)
    test_idx = np.load(split_dir / f"{prefix}_test_idx.npy").astype(np.int64)
    return train_idx, test_idx


def build_classifiers(random_state=42):
    et = ExtraTreesClassifier(
        n_estimators=600,
        max_features="sqrt",
        min_samples_leaf=1,
        random_state=random_state,
        n_jobs=-1,
        max_depth=50,   )
    xgb = XGBClassifier(
        n_estimators=520,
        learning_rate=0.03,
        max_depth=50,
        subsample=0.85,
        colsample_bytree=0.85,
        objective="binary:logistic",
        eval_metric="auc",
        tree_method="hist",
        random_state=random_state,
        n_jobs=-1,
    )
    lgbm = LGBMClassifier(
        n_estimators=520,
        learning_rate=0.03,
        num_leaves=63,
        subsample=0.85,
        colsample_bytree=0.85,
        random_state=random_state,
        n_jobs=-1,
    )
    return et, xgb, lgbm


def weighted_prob(prob_et, prob_xgb, prob_lgbm, weights):
    w_et, w_xgb, w_lgbm = weights
    return (prob_et * w_et + prob_xgb * w_xgb + prob_lgbm * w_lgbm) / (w_et + w_xgb + w_lgbm)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dataset", default="Data/dataset2.npy")
    parser.add_argument("--feature", default="features/dataset2_saprot_center_mean_AE384.npy")
    parser.add_argument("--split_dir", default="splits/ae_family_nearmiss5178")
    parser.add_argument("--split_prefix", default="dataset2_nearmiss_saprot_center_mean_AE384_neg5178_seed42")
    parser.add_argument("--model_out", default="models/Model1.pkl")
    parser.add_argument("--result_out", default="results/dataset2_softvoting_result.csv")
    parser.add_argument("--weights", default="7,6,1", help="weights for ET,XGB,LGBM, e.g. 7,6,1")
    parser.add_argument("--threshold", type=float, default=0.5)
    parser.add_argument("--random_state", type=int, default=42)
    args = parser.parse_args()

    Path(args.model_out).parent.mkdir(parents=True, exist_ok=True)
    Path(args.result_out).parent.mkdir(parents=True, exist_ok=True)

    y_all = load_labels(args.dataset)
    X_all = np.load(args.feature).astype(np.float32)
    train_idx, test_idx = load_indices(args.split_dir, args.split_prefix)

    X_train, y_train = X_all[train_idx], y_all[train_idx]
    X_test, y_test = X_all[test_idx], y_all[test_idx]

    print("Train:", count_labels(y_train))
    print("Test :", count_labels(y_test))

    et, xgb, lgbm = build_classifiers(args.random_state)

    print("Training ExtraTrees...")
    et.fit(X_train, y_train)
    print("Training XGBoost...")
    xgb.fit(X_train, y_train)
    print("Training LightGBM...")
    lgbm.fit(X_train, y_train)

    prob_et = et.predict_proba(X_test)[:, 1]
    prob_xgb = xgb.predict_proba(X_test)[:, 1]
    prob_lgbm = lgbm.predict_proba(X_test)[:, 1]

    weights = tuple(int(x.strip()) for x in args.weights.split(","))
    prob_ens = weighted_prob(prob_et, prob_xgb, prob_lgbm, weights)

    rows = []
    for name, prob in [
        ("ExtraTrees", prob_et),
        ("XGBoost", prob_xgb),
        ("LightGBM", prob_lgbm),
        (f"SoftVoting_{weights[0]}_{weights[1]}_{weights[2]}", prob_ens),
    ]:
        m = calc_metrics(y_test, prob, threshold=args.threshold)
        m.update({"model": name, "threshold": args.threshold})
        rows.append(m)

    result_df = pd.DataFrame(rows)
    result_df.to_csv(args.result_out, index=False, encoding="utf-8-sig")
    print(result_df)

    model_pack = {
        "et": et,
        "xgb": xgb,
        "lgbm": lgbm,
        "weights": {"et": weights[0], "xgb": weights[1], "lgbm": weights[2]},
        "threshold": args.threshold,
        "feature": args.feature,
        "split_prefix": args.split_prefix,
    }
    joblib.dump(model_pack, args.model_out)
    print(f"Saved model: {args.model_out}")

    with open(Path(args.result_out).with_suffix(".json"), "w", encoding="utf-8") as f:
        json.dump({"weights": weights, "metrics": rows}, f, ensure_ascii=False, indent=2)


if __name__ == "__main__":
    main()
